<Page
    x:Class="Math4Kid.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="Segoe UI"
    FontSize="20"
    Foreground="White">

    <!--LayoutRoot is the root grid where all page content is placed-->
    <Grid x:Name="LayoutRoot">
        <Grid.Background>
            <ImageBrush ImageSource="/Math4Kid;component/Resources/Background/MainPageBackground.png"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--<Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>-->

        <Grid x:Name="ContentPanel" Grid.Row="1" Margin="0">
            <Grid x:Name="LeftMainPanel" Margin="48,0,0,0" VerticalAlignment="Bottom" Width="350" Height="320" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="LeftLeft" Grid.Column="0" VerticalAlignment="Bottom">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button x:Name="btn_HocSo" AutomationProperties.Name="Learn numbers" ToolTip="Learn numbers" Content="" Height="160" Width="160" Grid.Row="0" Click="btn_HocSo_Click" BorderThickness="0">
                        <Button.Background>
                            <ImageBrush ImageSource="/Math4Kid;component/Resources/MainButton/HocSo.png"/>
                        </Button.Background>
                    </Button>
                    <Button x:Name="btn_GameSoSanh" AutomationProperties.Name="Compare numbers" ToolTip="Compare numbers" Content="" Height="160" Width="160" Grid.Row="1" Click="btn_GameSoSanh_Click" BorderThickness="0">
                        <Button.Background>
                            <ImageBrush Stretch="Fill" ImageSource="/Math4Kid;component/Resources/MainButton/SoSanh.png"/>
                        </Button.Background>
                    </Button>
                </Grid>
                <Grid x:Name="RightLeft" Grid.Column="1" VerticalAlignment="Bottom">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button x:Name="btn_GameCongTru" AutomationProperties.Name="Addition and subtraction" ToolTip="Addition and subtraction" Content="" Height="160" Width="160" Grid.Row="0" Click="btn_GameCongTru_Click" BorderThickness="0">
                        <Button.Background>
                            <ImageBrush Stretch="Fill" ImageSource="/Math4Kid;component/Resources/MainButton/CongTru.png"/>
                        </Button.Background>
                    </Button>
                    <Button x:Name="btn_GameSameNumber" AutomationProperties.Name="Match pairs" ToolTip="Match pairs" Content="" Height="160" Width="160" Grid.Row="1" Click="btn_GameSameNumber_Click" BorderThickness="0">
                        <Button.Background>
                            <ImageBrush Stretch="Fill" ImageSource="/Math4Kid;component/Resources/MainButton/TimSo.png"/>
                        </Button.Background>
                    </Button>
                </Grid>
            </Grid>

            <Grid x:Name="RightMainPanel" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="350" Height="320" Margin="0,0,48,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="LeftRight" Grid.Column="0" VerticalAlignment="Bottom">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button x:Name="btn_DaySo" AutomationProperties.Name="Previous and next numbers" ToolTip="Previous and next numbers" Content="" Height="160" Width="160" Grid.Row="0" Click="btn_DaySo_Click" BorderThickness="0">
                        <Button.Background>
                            <ImageBrush Stretch="Fill" ImageSource="/Math4Kid;component/Resources/MainButton/DaySo.png"/>
                        </Button.Background>
                    </Button>
                    <Button x:Name="btn_TapDem" AutomationProperties.Name="Count objects" ToolTip="Count objects" Content="" Height="160" Width="160" Grid.Row="1" Click="btn_TapDem_Click" BorderThickness="0">
                        <Button.Background>
                            <ImageBrush Stretch="Fill" ImageSource="/Math4Kid;component/Resources/MainButton/TapDem.png"/>
                        </Button.Background>
                    </Button>
                </Grid>
                <Grid x:Name="RightRight" Grid.Column="1" VerticalAlignment="Bottom">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button x:Name="btn_DayTang" AutomationProperties.Name="Ascending order" ToolTip="Ascending order" Content="" Height="160" Width="160" Grid.Row="0" Click="btn_DayTang_Click" BorderThickness="0">
                        <Button.Background>
                            <ImageBrush Stretch="Fill" ImageSource="/Math4Kid;component/Resources/MainButton/DayTang.png"/>
                        </Button.Background>
                    </Button>
                    <Button x:Name="btn_DayGiam" AutomationProperties.Name="Descending order" ToolTip="Descending order" Content="" Height="160" Width="160" Grid.Row="1" Click="btn_DayGiam_Click" BorderThickness="0">
                        <Button.Background>
                            <ImageBrush Stretch="Fill" ImageSource="/Math4Kid;component/Resources/MainButton/DayGiam.png"/>
                        </Button.Background>
                    </Button>
                </Grid>
            </Grid>
            <Grid x:Name="TitlePanel" HorizontalAlignment="Center" Height="150" Margin="0,12,0,0" VerticalAlignment="Top" Width="600">
                <Grid.Background>
                    <ImageBrush Stretch="Fill" ImageSource="/Math4Kid;component/Resources/Background/Title_en.png"/>
                </Grid.Background>
            </Grid>
            <Image x:Name="InfoImageIcon" HorizontalAlignment="Right" Height="50" Margin="0,0,8,8" VerticalAlignment="Bottom" Width="50" Source="/Math4Kid;component/Resources/Buttons/infoIcon.png" MouseLeftButtonUp="InfoImageIcon_Tap"/>
        </Grid>
    </Grid>

</Page>
